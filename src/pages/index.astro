---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import ServiceAreaList from '../components/ServiceAreaList.astro';
import Icon from '../components/Icon.astro';
import { plumbingServices } from '../data/services.js';
import { business } from '../data/business.js';
const teasers = ['Drips, leaks & running toilets', 'Repair & replacement', 'Slow drains & stubborn clogs', 'Repairs, replacements & updates'];
---
<SiteLayout title="Potts Plumbing | Your Local North Georgia Plumber" description="Residential plumbing in North Georgia. Get help with leaks, water heaters, drains, and fixtures. Email Potts Plumbing or call (770) 685-3901." currentPage="home">
  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span>Residential plumbing · North Georgia</p>
          <h1>Your home,<br />your local<br /><em>North Georgia</em><br />plumber.</h1>
          <p class="hero-intro">From a leaking faucet to a new water heater, get the help your home needs with Potts Plumbing.</p>
          <div class="contact-actions"><a class="button button-primary" href="#free-quote">Get a free quote<Icon name="arrow" /></a><a class="phone-link" href={business.phoneHref}><Icon name="phone" /><span>{business.phone}</span></a></div>
          <p class="action-note">A quick form is just below.</p>
        </div>
        <div class="service-picker">
          <div class="picker-heading"><span class="eyebrow">How can we help?</span><span class="picker-number">01—04</span></div>
          <h2>A fix for the everyday.<br />A hand with the bigger jobs.</h2>
          <div class="picker-links">
            {plumbingServices.slice(0, 4).map((service, index) => <a href={`/services/#${service.id}`}><span class="service-icon"><Icon name={service.icon} /></span><span><strong>{service.title}</strong><small>{teasers[index]}</small></span><Icon name="arrow" class="row-arrow" /></a>)}
          </div>
          <a class="picker-more" href="/services/#other-home-projects">Other home projects<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="container hero-foot"><p>Trusted by North Georgia</p><span>Locally owned by Garrett Potts</span><a href="/about/">Meet Garrett<Icon name="arrow" /></a></div>
    </section>
    <section class="section quote-section" id="free-quote" aria-labelledby="quote-heading">
      <div class="container quote-grid">
        <div class="quote-copy"><p class="eyebrow">Get started</p><h2 id="quote-heading">A quick form to get a free quote.</h2><p>Tell us a little about the plumbing work. Garrett will follow up to discuss the details.</p><a class="phone-link" href={business.phoneHref}><Icon name="phone" /><span>Prefer to call? {business.phone}</span></a></div>
        <form class="quote-form" name="quote-request" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="quote-request" />
          <p class="honeypot" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="form-row"><div class="form-field"><label for="quote-name">Your name <span aria-hidden="true">*</span></label><input id="quote-name" name="name" type="text" autocomplete="name" maxlength="100" required /></div><div class="form-field"><label for="quote-phone">Phone number <span aria-hidden="true">*</span></label><input id="quote-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" required /></div></div>
          <div class="form-field"><label for="quote-email">Email <span class="field-optional">optional</span></label><input id="quote-email" name="email" type="email" autocomplete="email" maxlength="254" /></div>
          <div class="form-field"><label for="quote-details">What can we help with? <span aria-hidden="true">*</span></label><textarea id="quote-details" name="details" rows="4" maxlength="2000" placeholder="For example: a leaking faucet or a water heater replacement" required></textarea></div>
          <div class="quote-form-footer"><p>* Required fields</p><button class="button button-primary" type="submit">Send quote request<Icon name="arrow" /></button></div>
        </form>
      </div>
    </section>
    <section class="section approach-section">
      <div class="container approach-grid">
        <div><p class="eyebrow">Good work. No guesswork.</p><h2>A clear conversation.<br />A better experience.</h2><a class="text-link" href="/about/">Our approach<Icon name="arrow" /></a></div>
        <div class="standards">
          <article><span class="standard-number">01</span><div><h3>Transparent pricing</h3><p>Understand the work and the price before you decide how to move forward.</p></div></article>
          <article><span class="standard-number">02</span><div><h3>Best-in-class service</h3><p>Clear communication, care in the details, and respect for your home.</p></div></article>
        </div>
      </div>
    </section>
    <section class="section area-section" id="service-area">
      <div class="container area-grid">
        <div><p class="eyebrow"><Icon name="pin" />Close to home</p><h2>North Georgia.<br />Our kind of place.</h2><p>Serving these communities and nearby areas. Get in touch to check service for your home.</p><a class="text-link" href="/contact/">Ask about your area<Icon name="arrow" /></a></div>
        <ServiceAreaList />
      </div>
    </section>
    <ContactBand />
  </main>
</SiteLayout>
