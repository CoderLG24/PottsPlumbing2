---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactActions from '../components/ContactActions.astro';
import ContactBand from '../components/ContactBand.astro';
import Icon from '../components/Icon.astro';
import { plumbingServices } from '../data/services.js';
import { business } from '../data/business.js';
---
<SiteLayout title="Home Plumbing Services | Potts Plumbing, North Georgia" description="Help with leaking faucets, water heaters, clogged drains, bathroom fixtures, and other home plumbing projects across North Georgia." currentPage="services">
  <main id="main-content">
    <section class="page-hero"><div class="container"><p class="eyebrow">Our services</p><h1>Small repair.<br /><em>Bigger</em> peace of mind.</h1><p>Practical help for the plumbing you rely on every day. Tell us what’s happening—no diagnosis needed.</p><ContactActions /></div></section>
    <section class="section services-section" aria-labelledby="services-heading"><div class="container services-layout">
      <aside class="service-nav"><p class="eyebrow" id="services-heading">Home plumbing</p><nav aria-label="Service categories">{plumbingServices.map(service => <a href={`#${service.id}`}>{service.title}<Icon name="arrow" /></a>)}</nav><p>Not sure where to start?<br /><a href="/contact/">Tell us about the problem.</a></p></aside>
      <div class="service-list">{plumbingServices.map((service, index) => <article class="service-article" id={service.id}>
        <div class="service-article-top"><span class="service-icon"><Icon name={service.icon} /></span><span class="eyebrow">{String(index + 1).padStart(2, '0')}</span></div>
        <h2>{service.title}</h2><p>{service.description}</p>
        <ul class="check-list">{service.examples.map(example => <li><Icon name="check" />{example}</li>)}</ul>
        <a class="text-link" href={`${business.emailHref}?subject=${encodeURIComponent(`Plumbing inquiry: ${service.title}`)}`}>Email about {index === 4 ? 'your project' : service.title.toLowerCase()}<Icon name="arrow" /></a>
      </article>)}</div>
    </div></section>
    <ContactBand title="Not sure what the problem is?" />
  </main>
</SiteLayout>