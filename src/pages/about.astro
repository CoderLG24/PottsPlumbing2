---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import ContactActions from '../components/ContactActions.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="About Garrett Potts | Potts Plumbing, North Georgia" description="Meet Potts Plumbing, Garrett Potts’s locally owned plumbing business serving North Georgia homes with clear communication and personal service." currentPage="about">
  <main id="main-content">
    <section class="page-hero"><div class="container"><p class="eyebrow">The name behind the work</p><h1>Local roots.<br /><em>Personal</em> service.</h1><p>Potts Plumbing is Garrett Potts’s locally owned plumbing business, helping homeowners across North Georgia.</p><ContactActions /></div></section>
    <section class="section"><div class="container about-grid">
      <figure class="brand-portrait"><img src="/images/potts-wordmark.png" width="666" height="544" alt="Potts Plumbing, 770-685-3901" loading="lazy" /><figcaption>Trusted by North Georgia</figcaption></figure>
      <div class="about-copy"><p class="eyebrow">A straightforward approach</p><h2>Your home deserves<br />care and attention.</h2><p>Plumbing work starts with a conversation. Share what you’re noticing or planning, and we can talk through the options for your home.</p><div class="standards"><article><Icon name="pricing" /><div><h3>Know what comes next.</h3><p>Transparent pricing means understanding the proposed work and price before deciding to proceed.</p></div></article><article><Icon name="service" /><div><h3>Feel looked after.</h3><p>Best-in-class service means thoughtful communication and respect for your home, from the first question to the work itself.</p></div></article></div><a class="text-link" href="/services/">See how we can help<Icon name="arrow" /></a></div>
    </div></section>
    <ContactBand title="A local name you can reach directly." />
  </main>
</SiteLayout>