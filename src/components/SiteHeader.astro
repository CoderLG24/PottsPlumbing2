---
const { currentPage } = Astro.props;
const navigation = [
  { label: 'Home', href: '/', id: 'home' },
  { label: 'Services', href: '/services/', id: 'services' },
  { label: 'About', href: '/about/', id: 'about' },
  { label: 'Contact', href: '/contact/', id: 'contact' },
];
---

<header class="site-header">
  <div class="site-header__top container">
    <a class="brand" href="/" aria-label="Potts Plumbing home">
      <img src="/images/potts-mark.png" width="44" height="54" alt="" fetchpriority="high" />
      <span class="brand__name">Potts Plumbing<span class="brand__region">North Georgia</span></span>
    </a>
    <div class="header-contact" aria-label="Contact Potts Plumbing">
      <a class="header-contact__email" href="mailto:gtpservices212@gmail.com">Email</a>
      <a class="header-contact__phone" href="tel:+17706853901">(770) 685-3901</a>
    </div>
  </div>
  <div class="site-header__navigation">
    <div class="container navigation-wrap">
      <nav class="desktop-nav" aria-label="Primary">
        {navigation.map((item) => (
          <a href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <details class="mobile-menu">
        <summary><span>Menu</span><span class="menu-glyph" aria-hidden="true"></span></summary>
        <nav aria-label="Mobile">
          {navigation.map((item) => (
            <a href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
      <span class="navigation-note">Residential plumbing · North Georgia</span>
    </div>
  </div>
</header>
