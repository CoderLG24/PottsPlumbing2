---
import Icon from './Icon.astro';
import { business } from '../data/business.js';
const { currentPage } = Astro.props;
const navigation = [
  { label: 'Home', href: '/', id: 'home' },
  { label: 'Services', href: '/services/', id: 'services' },
  { label: 'About', href: '/about/', id: 'about' },
  { label: 'Contact', href: '/contact/', id: 'contact' },
  { label: 'Free quote', href: '/#free-quote', id: 'quote' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Potts Plumbing home">
      <img src="/images/potts-horizontal.png" width="1326" height="226" alt="" />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {navigation.map(item => <a href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="button button-primary header-email" href={business.emailHref}><Icon name="email" /><span>Email us</span></a>
    <details class="mobile-menu">
      <summary><span class="menu-glyph" aria-hidden="true"></span><span>Menu</span></summary>
      <nav aria-label="Mobile">
        {navigation.map(item => <a href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>{item.label}</a>)}
        <a class="mobile-nav-phone" href={business.phoneHref}><Icon name="phone" />{business.phone}</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const trigger = menu?.querySelector('summary');
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; trigger?.focus(); }
  });
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  const wideScreen = window.matchMedia('(min-width: 64.01rem)');
  wideScreen.addEventListener('change', () => { if (wideScreen.matches && menu) menu.open = false; });
</script>
