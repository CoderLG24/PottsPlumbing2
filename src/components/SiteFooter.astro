---
import { business } from '../data/business.js';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div><a class="brand" href="/" aria-label="Potts Plumbing home"><img src="/images/potts-mark.png" width="44" height="54" alt="" loading="lazy" /><span class="brand-name">Potts Plumbing<span class="brand-region">North Georgia</span></span></a><p>Local plumbing. Personal service.</p></div>
      <nav aria-label="Footer"><a href="/">Home</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
      <div class="footer-contact"><a href={business.emailHref}>{business.email}</a><a href={business.phoneHref}>{business.phone}</a></div>
    </div>
    <div class="footer-bottom"><small>© {new Date().getFullYear()} Potts Plumbing</small><span>Serving North Georgia homes.</span></div>
  </div>
</footer>
<nav class="mobile-contact-bar" aria-label="Quick contact">
  <a href={business.phoneHref}><Icon name="phone" /><span>Call {business.phone}</span></a>
  <a href={business.emailHref} class="button button-primary"><Icon name="email" />Email us</a>
</nav>