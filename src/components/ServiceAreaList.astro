---
const towns = [
  'Talking Rock',
  'Jasper',
  'Ellijay',
  'Nelson',
  'Tate',
  'Ball Ground',
  'Dawsonville',
  'Dahlonega',
  'Cumming',
  'Canton',
  'Woodstock',
];
---

<ul class="town-list">
  {towns.map((town, index) => (
    <li><span class="town-list__number">{String(index + 1).padStart(2, '0')}</span><span>{town}</span></li>
  ))}
</ul>
